# ============================================================
# AI Hub — Environment Variables
# ============================================================
# This file is a TEMPLATE. Copy it to `.env` locally:
#   cp .env.example .env
#
# NEVER commit real secrets. Real keys, passwords, and tokens
# belong in `.env`, `.env.local`, or a secure secret manager
# (see docs/06_AWS_Cloud_Architecture.md for the production
# secrets strategy). `.env*` files are git-ignored.
# ============================================================

# ------------------------------------------------------------
# 1. Local Development (used today)
# ------------------------------------------------------------

# Backend (FastAPI)
ENVIRONMENT=development
DEBUG=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database (SQLAlchemy + Alembic)
# Local development: SQLite file, no external service required.
DATABASE_URL=sqlite:///./aihub_dev.db
# Staging/production and AI_DEPLOYMENT=true require an explicit Supabase
# PostgreSQL URL; startup and Alembic fail fast if SQLite is selected.
# Use the psycopg 3 driver (already in backend/requirements.txt), URL-encode
# special characters in the password, and keep TLS enabled. Use the Supabase
# direct connection or session pooler for migrations; do not use a
# transaction pooler for Alembic.
# DATABASE_URL=postgresql+psycopg://postgres:<url-encoded-password>@<host>:5432/postgres?sslmode=require

# CORS origins allowed to call the API during local development.
# JSON list format (pydantic-settings).
CORS_ORIGINS=["http://localhost:3000"]

# Frontend (Next.js)
# Public URL of the FastAPI backend, exposed to the browser.
# Next.js reads this from frontend/.env.local (copy this file there).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase Auth (frontend) — required for sign in / sign up.
# The anon key is safe to expose to the browser by design.
# NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ------------------------------------------------------------
# 2. AI Provider Configuration (shared by every assistant)
# ------------------------------------------------------------
# AI Hub uses an OpenAI-compatible chat completions API. Provider
# configuration is explicit: AI_PROVIDER, AI_BASE_URL, and AI_MODEL must
# all be set whenever AI_API_KEY is set. There is no implicit provider
# fallback.
#
# The API key is read from the environment only. NEVER commit a real
# key. Without a key the platform still runs, but Resume ATS and IT
# Support Copilot respond 503 until one is configured.
#
# Local DeepSeek (minimum required configuration):
# AI_PROVIDER=deepseek
# AI_API_KEY=<your-deepseek-api-key>
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-flash
#
# Local or production OpenAI (minimum required configuration):
# AI_PROVIDER=openai
# AI_API_KEY=<your-openai-api-key>
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=<valid-openai-model>
#
# Staging and production must use OpenAI. DeepSeek is allowed only in
# explicitly configured local/test environments.
#
# Deployment safeguard. Set AI_DEPLOYMENT=true in staging and production.
# It is required outside explicit local/test environments; startup fails
# if it is missing or false. When enabled, OpenAI is required even if
# ENVIRONMENT=development. Local development leaves this disabled:
# AI_DEPLOYMENT=false
#
# AI_TIMEOUT_SECONDS=60                 # optional, default 60
#
# DeepSeek enables thinking mode by default, where temperature is
# ignored. AI Hub auto-disables thinking for DeepSeek so each
# assistant's temperature applies. Override explicitly if needed:
# AI_THINKING=false                     # true/false; unset = auto
# AI_REASONING_EFFORT=high              # low/high/max (thinking only)
#
# Optional per-assistant model overrides. Both fall back to AI_MODEL:
# RESUME_ATS_MODEL=deepseek-flash
# SUPPORT_MODEL=deepseek-flash
#
# Legacy names are still read as fallbacks for existing local setups:
# OPENAI_API_KEY, OPENAI_BASE_URL, OPENAI_MODEL, OPENAI_TIMEOUT_SECONDS.
# They do not replace the requirement to configure the provider
# explicitly. Leave AI_THINKING unset for non-DeepSeek providers.

# Upload limits (resume_ats domain)
# MAX_UPLOAD_SIZE_MB=5               # optional, default 5

# ------------------------------------------------------------
# 3. Supabase Authentication (used by protected API endpoints)
# ------------------------------------------------------------
# Backend (FastAPI): validates Supabase-issued JWTs on protected
# endpoints (/resumes, /analyses, /support). Two modes, kept separate:
# - ES256 (current Supabase default): public keys resolved from the
#   project JWKS. Requires SUPABASE_URL; issuer and audience are
#   validated.
# - HS256 (legacy): SUPABASE_JWT_SECRET, for older tokens still in
#   circulation.
# Without both SUPABASE_URL and SUPABASE_JWT_SECRET, tokens of the
# corresponding type cannot be validated (401).
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_JWT_SECRET=<project-jwt-secret>   # server-side only — never expose to the browser
# SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json  # optional override
# SUPABASE_ANON_KEY=<anon-key>               # reserved for future use
# SUPABASE_SERVICE_ROLE_KEY=<service-role>   # server-side only — never expose to the browser

# Observability
# SENTRY_DSN=

# ------------------------------------------------------------
# 4. Production Secrets (managed securely, never in this repo)
# ------------------------------------------------------------
# In production these are injected via the deployment environment
# or a secrets manager (AWS Secrets Manager / Vercel env vars).
# They are listed here for visibility only.
