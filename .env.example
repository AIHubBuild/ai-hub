# ============================================================
# AI Hub — Environment Variables
# ============================================================
# This file is a TEMPLATE. Copy it to `.env` locally:
#   cp .env.example .env
#
# NEVER commit real secrets. Real keys, passwords, and tokens
# belong in `.env`, `.env.local`, or a secure secret manager
# (see docs/06_AWS_Cloud_Architecture.md for the production
# secrets strategy). `.env*` files are git-ignored.
# ============================================================

# ------------------------------------------------------------
# 1. Local Development (used today)
# ------------------------------------------------------------

# Backend (FastAPI)
ENVIRONMENT=development
DEBUG=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database (SQLAlchemy + Alembic)
# Local development: SQLite file, no external service required.
DATABASE_URL=sqlite:///./aihub_dev.db
# Staging/production: Supabase PostgreSQL (docs/05_Database_Design.md).
# The psycopg driver is added when Supabase integration lands.
# DATABASE_URL=postgresql+psycopg://postgres:password@host:5432/postgres

# CORS origins allowed to call the API during local development.
# JSON list format (pydantic-settings).
CORS_ORIGINS=["http://localhost:3000"]

# Frontend (Next.js)
# Public URL of the FastAPI backend, exposed to the browser.
# Next.js reads this from frontend/.env.local (copy this file there).
NEXT_PUBLIC_API_URL=http://localhost:8000

# ------------------------------------------------------------
# 2. AI Provider Configuration (resume_ats domain uses this today)
# ------------------------------------------------------------
# The ATS analysis endpoints require an OpenAI-compatible chat
# completions API. Without OPENAI_API_KEY the platform still runs, but
# /resumes/{id}/ats-analysis responds 503 until a key is configured.
# NEVER commit real keys.
# OPENAI_API_KEY=sk-...              # required for AI analysis
# OPENAI_MODEL=gpt-4.1-mini          # optional, default gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # optional override for compatible providers
# OPENAI_TIMEOUT_SECONDS=60          # optional, default 60

# Upload limits (resume_ats domain)
# MAX_UPLOAD_SIZE_MB=5               # optional, default 5

# ------------------------------------------------------------
# 3. Future Service Configuration (NOT used yet)
# ------------------------------------------------------------
# Placeholders for services introduced in later phases.
# Do not populate these with real values yet.

# Supabase (Authentication + PostgreSQL + Storage)
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_JWT_SECRET=              # backend token validation (HS256) — server-side only
# SUPABASE_SERVICE_ROLE_KEY=   # server-side only — never expose to the browser

# Observability
# SENTRY_DSN=

# ------------------------------------------------------------
# 3. Production Secrets (managed securely, never in this repo)
# ------------------------------------------------------------
# In production these are injected via the deployment environment
# or a secrets manager (AWS Secrets Manager / Vercel env vars).
# They are listed here for visibility only.
